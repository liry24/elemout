{
    "name": "elemout",
    "version": "0.0.0",
    "private": true,
    "description": "Tool to hide unwanted elements on web pages",
    "author": {
        "name": "Liry24",
        "url": "https://liry24.com"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/liry24"
    },
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "postinstall": "wxt prepare",
        "submit": "wxt submit"
    },
    "dependencies": {
        "@asamuzakjp/dom-selector": "^8.0.1",
        "@iconify/vue": "^5.0.1",
        "@octokit/auth-oauth-device": "^8.0.3",
        "@repo/github": "workspace:*",
        "@tanstack/vue-hotkeys": "^0.10.0",
        "@vueuse/core": "^14.3.0",
        "@vueuse/shared": "^14.3.0",
        "@wxt-dev/i18n": "^0.2.5",
        "clsx": "2.1.1",
        "comctx": "^1.6.1",
        "css-selector-generator": "^3.9.2",
        "destr": "^2.0.5",
        "fflate": "^0.8.2",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.0",
        "vue": "^3.5.34",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.0",
        "@wxt-dev/auto-icons": "^1.1.1",
        "@wxt-dev/module-vue": "^1.0.3",
        "bumpp": "^11.1.0",
        "daisyui": "^5.5.19",
        "oxfmt": "^0.49.0",
        "oxlint": "^1.64.0",
        "taze": "^19.11.0",
        "typescript": "6.0.3",
        "vitest": "^4.1.6",
        "vue-tsc": "^3.2.9",
        "wxt": "^0.20.26"
    },
    "overrides": {
        "vite": "^8.0.0"
    },
    "packageManager": "bun@1.3.14"
